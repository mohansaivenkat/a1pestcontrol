# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Next.js & Build Outputs
/.next/
/out/
/build/
/dist/
/.turbo/
*.tsbuildinfo
next-env.d.ts

# Testing & Code Coverage
/coverage/
*.lcov
.nyc_output/

# Environment Variables & Local Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs & Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Logs & Debuggers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Vercel & Cloud Deployments
.vercel

# Temporary Files & Caches
*.tmp
*.temp
.cache/
.eslintcache

# Hallmark & Visual Audit Artifacts (generated outputs)
.hallmark/shots/
.hallmark/before/
.hallmark/before.txt
.hallmark/compare.html
